{
  "name": "notification-engine-server",
  "version": "0.1.0",
  "description": "Notification Engine API — Sequelize + MySQL + SMTP + schedulers (Biogas MIS patterns)",
  "main": "app.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "create-db": "node scripts/create_db.js",
    "seed": "node scripts/seed.js",
    "create-users": "node scripts/create_users.js",
    "init-db": "node scripts/create_db.js && node scripts/seed.js",
    "sync-db": "node scripts/sync_db.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
