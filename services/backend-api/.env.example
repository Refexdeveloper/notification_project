PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# --- PostgreSQL (optional for local UI dev) ---
# Copy this file to .env before running:  cp .env.example .env
#
# Without PostgreSQL: leave PGPASSWORD empty — API runs in dev mode (empty applications list).
# With PostgreSQL: set PGPASSWORD and run migrations in db/migrations/

DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=engagement_reporting

# Set true to force connection attempt even with empty password (not recommended)
# PG_CONNECT=true

# Set true to skip all database access
# SKIP_DATABASE=true

# CORS — Admin UI origin
CORS_ORIGIN=http://localhost:3000

# Platform login (Admin UI email/password)
PLATFORM_BOOTSTRAP_EMAIL=mohamedaasik.m@refex.co.in
PLATFORM_BOOTSTRAP_NAME=Mohamed Asaik
PLATFORM_BOOTSTRAP_PASSWORD=Refex@2026
PLATFORM_SESSION_SECRET=change-me-in-production

# Optional: allow IAP email to map to an existing platform user (not used for Admin UI auto-login)
# ALLOW_IAP_SESSION=true

# Git SHA injected at build time
GIT_SHA=local

# --- Application registration (Secret Manager refs only; values never stored in PostgreSQL) ---
GCP_PROJECT=master-diorama-489103-u2
# KISSFLOW_KEY_ID_SECRET=projects/master-diorama-489103-u2/secrets/kissflow-developer-key-id
# KISSFLOW_KEY_SECRET_SECRET=projects/master-diorama-489103-u2/secrets/kissflow-developer-key-secret
