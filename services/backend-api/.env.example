PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (Cloud SQL via proxy in production)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=engagement_reporting

# CORS — Admin UI origin
CORS_ORIGIN=http://localhost:3000

# Dev session stub when IAP headers absent
DEV_AUTH_EMAIL=dev@refex.co.in
DEV_AUTH_NAME=Dev Operator
DEV_AUTH_ROLE=ADMIN

# Git SHA injected at build time
GIT_SHA=local
